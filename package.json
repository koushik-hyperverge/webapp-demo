{
  "name": "webapp-demo",
  "version": "v1",
  "private": true,
  "type": "module",
  "description": "First demo webapp from create-scaffold-webapp",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
